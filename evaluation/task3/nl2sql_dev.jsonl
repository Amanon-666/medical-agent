{"id": "nl2sql_0097", "question": "哪些疾病同时有关联症状、药物和检查记录？列出疾病名及各类型记录数。", "difficulty": "hard", "query_type": "多表联查", "gold_sql": "SELECT s.disease, COUNT(DISTINCT s.symptom) AS symptom_count, COUNT(DISTINCT d.drug) AS drug_count, COUNT(DISTINCT t.test) AS test_count FROM disease_symptoms s JOIN disease_drugs d ON s.disease = d.disease JOIN disease_tests t ON s.disease = t.disease GROUP BY s.disease ORDER BY (symptom_count + drug_count + test_count) DESC LIMIT 15", "gold_result": {"columns": ["disease", "symptom_count", "drug_count", "test_count"], "rows": [["脑炎", 91, 46, 69], ["溃疡性结肠炎", 94, 71, 37], ["慢性胰腺炎", 61, 50, 38], ["肝硬化", 60, 43, 44], ["急性胰腺炎", 47, 51, 46], ["川崎病", 87, 36, 18], ["食物中毒", 50, 62, 26], ["帕金森病", 62, 43, 31], ["急性阑尾炎", 63, 41, 29], ["心肌炎", 53, 51, 26], ["阿尔茨海默病", 40, 56, 31], ["多发性骨髓瘤", 26, 72, 28], ["肾病综合征", 40, 62, 16], ["慢性阻塞性肺疾病", 26, 69, 20], ["急性淋巴细胞白血病", 47, 45, 22]], "row_count": 15}, "tables": ["disease_symptoms", "disease_drugs", "disease_tests"], "executable": true, "error": null, "notes": ""}
