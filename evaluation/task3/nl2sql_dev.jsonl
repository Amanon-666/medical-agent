{"id": "nl2sql_0099", "question": "多来源收录的疾病中，哪些同时有症状和检查记录？", "difficulty": "hard", "query_type": "多表联查", "gold_sql": "SELECT DISTINCT s.disease FROM disease_symptoms s INNER JOIN disease_tests t ON s.disease = t.disease INNER JOIN diseases d ON s.disease = d.name WHERE d.source_count > 1 LIMIT 20", "gold_result": {"columns": ["disease"], "rows": [["百日咳"], ["成人呼吸窘迫综合征"], ["放射性肺炎"], ["肺大疱"], ["肺脓肿"], ["肺栓塞"], ["肺炎"], ["肺水肿"], ["肺癌"], ["感冒"], ["感染性休克"], ["过敏性休克"], ["Goodpasture综合征"], ["呼吸衰竭"], ["呼吸道合胞病毒肺炎"], ["急性呼吸衰竭"], ["军团病"], ["急性呼吸窘迫综合征"], ["军团菌病"], ["金黄色葡萄球菌肺炎"]], "row_count": 20}, "tables": ["disease_symptoms", "disease_tests", "diseases"], "executable": true, "error": null, "notes": ""}
{"id": "nl2sql_0132", "question": "在所有症状中，哪些症状同时是至少5种不同科室的疾病所共有的？", "difficulty": "hard", "query_type": "复杂综合", "gold_sql": "SELECT s.symptom, COUNT(DISTINCT d.department) AS dept_count, COUNT(DISTINCT s.disease) AS disease_count FROM disease_symptoms s JOIN disease_departments d ON s.disease = d.disease GROUP BY s.symptom HAVING dept_count >= 5 ORDER BY disease_count DESC LIMIT 15", "gold_result": {"columns": ["symptom", "dept_count", "disease_count"], "rows": [["腹痛", 48, 1019], ["恶心", 50, 999], ["乏力", 47, 788], ["呼吸困难", 37, 772], ["腹泻", 43, 686], ["昏迷", 41, 429], ["结节", 40, 416], ["丘疹", 35, 391], ["低热", 44, 391], ["发绀", 38, 360], ["抽搐", 36, 337], ["消瘦", 42, 317], ["瘙痒", 40, 315], ["淋巴结肿大", 38, 301], ["便秘", 43, 299]], "row_count": 15}, "tables": ["disease_symptoms", "disease_departments"], "executable": true, "error": null, "notes": ""}
